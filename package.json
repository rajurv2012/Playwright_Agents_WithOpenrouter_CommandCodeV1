{
  "name": "playwright_agents_withopenrouter_commandcode",
  "version": "1.0.0",
  "description": "Playwright test automation framework with API, Web UI, and Database testing",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test tests/web",
    "test:api": "playwright test tests/api",
    "test:db": "playwright test tests/db",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install",
    "install:deps": "playwright install-deps",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\""
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "api",
    "ui",
    "database"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.0",
    "allure-playwright": "^3.14.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "luxon": "^3.7.2",
    "pg": "^8.11.0",
    "xlsx": "^0.18.5"
  }
}
